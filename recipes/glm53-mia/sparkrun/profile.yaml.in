# Generated by tools/render_sparkrun.py; no host launch or engine source changes.
recipe_version: '2'
model: $model
model_revision: $model_revision
runtime: tensorfold
container: $image
min_nodes: 2
max_nodes: 2
metadata:
  profile: $profile
  release: $release
  serving_profile: $serving_profile
  status: qualification-only
  engine_commit: $engine_commit
  kit_revision: $kit_revision
defaults:
  tensor_parallel: 2
  pipeline_parallel: 1
  host: 0.0.0.0
  port: 8888
  served_model_name: GLM-5.3-Flash
  context: 1048576
  max_tokens: 32768
  drafter: $drafter
  drafter_revision: $drafter_revision
  entrypoint: /usr/local/bin/tensorfold-entrypoint
env:
  HF_HUB_OFFLINE: '1'
  CUDA_DEVICE_ORDER: PCI_BUS_ID
  TENSORFOLD_NO_UPDATE_CHECK: '1'
  TENSORFOLD_NO_LIVE: '1'
  TENSORFOLD_MEMORY_RESERVE_GIB: '12'
  TENSORFOLD_PREFILL_SHARE: '0.68'
  TF_GLM_DENSE_BITS: '8'
  TF_GLM_HEAD_BITS: '8'
  TF_KV_PAGES: 'on'
  TF_GLM_KV_SHARD: '1'
  TF_PROMPT_CACHE_FIRST: '1'
  TF_GLM_HOST_CACHE_GIB: '0'
  TF_GLM_CLEAR_THINKING: '0'
  TF_GLM_CE_EXCHANGE: '0'
  TF_GLM_ABSORB_MMA: '1'
  TF_GLM_W8A8: '0'
  TF_ROCE: '1'
  TF_ROCE_MAX_KB: '4096'
  GLM_LEARN_DIR: $learn_dir
  GLM_LEARN_GIB: $learn_gib
  GLM_LEARN_MIN_FREE_GIB: '50'
  GLM_LEARN_DAILY_GIB: '128'
executor_config:
  entrypoint: ''
  user: root
  ipc: host
  shm_size: 16g
  devices:
    - /dev/infiniband
  cap_add:
    - IPC_LOCK
  ulimit:
    - memlock=-1:-1
    - stack=67108864
    - nofile=65535:65535
  auto_remove: false
runtime_cache:
  key_by_image: true
mods:
  - ../mods/glm53-native
post_exec:
  - python3 /opt/spark-inference/glm53-mia/capacity.py --learn-gib $learn_gib --learn-dir $learn_dir
  - python3 /opt/spark-inference/glm53-mia/readiness.py --model GLM-5.3-Flash --context 1048576 --lanes 4 --efforts max,high,low --require-kv-shard
distribution_config:
  models:
    entries:
      - name: $model
        revision: $model_revision
        target:
          - -1
      - name: $drafter
        revision: $drafter_revision
        target:
          - -1
